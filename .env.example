# Genesis OS environment variables reference (all values are placeholders — copy
# this file to .env.local for local dev and replace the values. NEVER commit
# real keys. Provider / server keys stay server-side and are never VITE_* vars.)

# ---------- CLIENT (Vite / browser) — required for the SPA to reach Supabase ----------
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"

# Optional aliases the code also reads (NEXT_PUBLIC_*):
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"

# ---------- LOCAL DEV ONLY — where the /api/* proxy forwards to ----------
# Set this if your local serverless functions do NOT run on localhost:3000.
# (See vite.config.js `server.proxy`.)
# VITE_API_PROXY_TARGET="http://localhost:3000"

# ---------- SERVER (Vercel Functions) — add in Vercel project env, NOT .env.local ----------
# Read by api/_lib/supabase.js. Requires the rls-migration.sql to be applied.
# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_ANON_KEY="your-server-anon-key"

# Optional Cloud AI provider keys (server-only, see SETUP_AI.md):
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."

# ---------- TIKTOK DIRECT POST (server-only; never expose as VITE_* values) ----------
# Create these only after registering Genesis OS in TikTok for Developers.
# TIKTOK_CLIENT_KEY="your-tiktok-client-key"
# TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
# TIKTOK_REDIRECT_URI="https://genesis-os-phi.vercel.app/api/tiktok/oauth/callback"
# TIKTOK_ACCESS_TOKEN="owner-authorized-access-token"
# TIKTOK_REFRESH_TOKEN="owner-authorized-refresh-token"
# Server-only AES-256-GCM key used to encrypt any token at rest through the vault seam
# (api/tiktok/_tokenStore.js). Use at least 32 random characters.
# TIKTOK_TOKEN_ENCRYPTION_KEY="at-least-32-random-server-only-characters"
# Signs the short-lived OAuth state cookie. May be a separate 32+ character secret.
# TIKTOK_OAUTH_STATE_SECRET="another-32-character-random-server-secret"
# Shared secret for incoming TikTok webhook verification (after domain verification).
# TIKTOK_WEBHOOK_SECRET="your-tiktok-webhook-secret"
# Keep false until TikTok has genuinely approved video.publish and completed its audit.
# TIKTOK_AUDIT_APPROVED="false"
